# Django
DJANGO_SECRET_KEY=your-very-secret-key-change-this
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_SETTINGS_MODULE=config.settings.local

# PostgreSQL (used in production / docker-compose)
POSTGRES_DB=aiplatform
POSTGRES_USER=aiplatform
POSTGRES_PASSWORD=aiplatform123
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Temporal
TEMPORAL_HOST=localhost:7233

# ChromaDB
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_PATH=chroma_data

# Langfuse
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_NEXTAUTH_SECRET=changeme-in-production
LANGFUSE_SALT=changeme-salt

# AI / LLM
AI_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o-mini
# Use openai_compatible and set AI_BASE_URL, AI_API_KEY, and DEFAULT_LLM_MODEL
# to switch to an OpenAI-compatible service such as DeepSeek.
# Example:
# AI_PROVIDER=openai_compatible
# DEFAULT_LLM_MODEL=deepseek-chat
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_API_KEY=your-provider-api-key
AI_API_KEY=
AI_BASE_URL=
# Kept separately for document embeddings; chat-provider keys do not replace it.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=

# Ollama (optional local LLM)
OLLAMA_BASE_URL=http://localhost:11434

# Document processing backend: celery | kafka | temporal
DOCUMENT_PROCESSING_BACKEND=celery

# CORS — React dev server
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# File upload limits
MAX_UPLOAD_SIZE_MB=50
